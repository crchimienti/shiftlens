# ShiftLens local settings. Copy to .env (git-ignored, loaded automatically) and fill in locally.
# Never commit .env or real keys. Variable names keep the original MATCHPULSE_ prefix (internal identifier).

# Dataset to load (relative to project root).
MATCHPULSE_DATASET_PATH=data/match_demo.json

# Online mode flag. 1 (default) = offline: every explanation is the deterministic fallback.
# 0 = try the optional Microsoft Foundry / Azure OpenAI path (requires all four values below).
MATCHPULSE_OFFLINE=1

# Optional Microsoft Foundry / Azure OpenAI deployment. Not validated against a live deployment yet.
# Endpoint of the Azure OpenAI resource, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# API key (sent as the api-key header; never logged or sent in the request body).
AZURE_OPENAI_API_KEY=
# Deployment (model) name.
AZURE_OPENAI_DEPLOYMENT=
# API version; structured outputs need 2024-08-01-preview or later, e.g. 2024-10-21.
AZURE_OPENAI_API_VERSION=

# Optional tuning.
# Seconds per call before falling back (default 15).
AZURE_OPENAI_TIMEOUT_SECONDS=15
# json_schema (default, strict structured output) or json_object (deployments without structured outputs).
AZURE_OPENAI_RESPONSE_FORMAT=json_schema
